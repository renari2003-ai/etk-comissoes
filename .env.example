# Copie este arquivo para ".env" e preencha com as credenciais do SEU aplicativo Omie.
# Crie um aplicativo dedicado no painel da Omie com permissão apenas de CONSULTA
# para as áreas: Pedidos de Venda, Produtos e Estoque. Nunca use uma chave com
# permissão de escrita neste aplicativo.

# Chave do aplicativo Omie (App Key)
OMIE_APP_KEY=

# Segredo do aplicativo Omie (App Secret)
OMIE_APP_SECRET=

# Porta em que o servidor local vai rodar (opcional, padrão 3000)
PORTA=3000

# Intervalo mínimo, em milissegundos, entre requisições à Omie (opcional, padrão 300)
OMIE_INTERVALO_MIN_MS=300

# Connection string do banco Postgres (Supabase) onde ficam os usuários do sistema
# de login — Project Settings > Database > Connection string > aba "URI" no painel
# do Supabase. Prefira a versão "Connection pooling" (porta 6543).
DATABASE_URL=

# Usuário e senha do primeiro administrador do sistema de login — usados só na
# primeira vez que o servidor sobe (quando a tabela "usuarios" no Postgres ainda
# está vazia e não há um data/usuarios.json antigo para migrar) para criar essa
# conta. Depois disso, gerencie usuários pela própria aba "Usuários" do app
# (visível só para administradores). Sem essas duas variáveis, o servidor recusa
# criar o primeiro administrador (nunca com senha padrão adivinhável).
ADMIN_USUARIO=
ADMIN_SENHA=

# Fase 4A.1 — segredo compartilhado do webhook máquina-a-máquina que recebe respostas de
# cotação de transportadoras (n8n → ETK, POST /api/fretes/integracoes/cotacoes/resposta).
# Gere um valor aleatório longo (ex.: openssl rand -hex 32) e configure o MESMO valor no
# fluxo do n8n, no header "x-fretes-webhook-secret". Sem esta variável (ou com o header
# incorreto), o webhook rejeita TODAS as chamadas — nunca aceita "sem segredo" como
# "sem proteção".
FRETES_WEBHOOK_SECRET=
